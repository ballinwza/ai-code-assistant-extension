{
  "name": "code-assistant",
  "displayName": "ai-code-assistant",
  "description": "AI code assistant connecting with external API",
  "version": "1.0.0",
  "publisher": "tradon",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ballinwza/ai-code-assistant-extension.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "AI Code Assistant",
      "properties": {
        "codeAssistant.backendUrl": {
          "type": "string",
          "default": "https://ai-code-assistant-17sb.onrender.com",
          "description": "URL ของ FastAPI Backend Service"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "code-assistant.sendToChat",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "code-assistant.openSidebar",
        "title": "Code Assistant: Open Chat Sidebar"
      },
      {
        "command": "code-assistant.sendToChat",
        "title": "💬 Ask AI about selected code"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-assistant-view-container",
          "title": "AI Code Assistant",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "code-assistant-view-container": [
        {
          "id": "code-assistant-sidebar",
          "type": "webview",
          "name": "Chat",
          "icon": "assets/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build-all",
    "build-all": "npx vite build && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsce": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.5.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.2.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "syntax-highlighter": "^0.0.3"
  }
}
